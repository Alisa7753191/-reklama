# Скопируйте в .env и заполните.

# Ключ Anthropic для гибридного режима (правила + ИИ). Без ключа приложение
# работает в режиме «только правила».
ANTHROPIC_API_KEY=

# Модель Claude (по умолчанию claude-opus-4-8).
ANTHROPIC_MODEL=claude-opus-4-8

# Провайдер LLM (пока поддерживается claude; заготовка под смену на РФ-модель).
LLM_PROVIDER=claude

# Таймаут загрузки лендинга по URL, сек.
URL_FETCH_TIMEOUT=20
